{
  "expo": {
    "name": "cuida-mais-prototipo",
    "slug": "cuida-mais-prototipo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/logo/app-icon-simples-1024.png",
    "scheme": "cuidarplus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/logo/app-icon-simples-1024.png",
      "bundleIdentifier": "br.com.cuidaplus.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4FBFD",
        "foregroundImage": "./src/logo/adaptive-icon-foreground-simples-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.cuidaplus.app"
    },
    "web": {
      "output": "static",
      "favicon": "./src/logo/icon-simples-512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4FBFD",
          "image": "./src/logo/icon-simples-512.png",
          "imageWidth": 128,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o Cuidar+ acesse suas fotos para adicionar imagens de perfil e comprovação de cuidados.",
          "cameraPermission": "Permita que o Cuidar+ use a câmera para tirar imagens de perfil e comprovação de cuidados.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
